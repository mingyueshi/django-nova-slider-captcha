include LICENSE README.md pyproject.toml package.json package-lock.json manage.py
recursive-include src/nova_slider_captcha *.py *.html *.css *.js *.po *.mo
recursive-include tests *.py *.mjs *.json
recursive-include scripts *.py *.cjs
