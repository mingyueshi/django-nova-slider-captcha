{
  "cwd": "<repo>",
  "path_redactions": {
    "<repo>": "repository root",
    "<work>": "new private task directory",
    "<home>": "local home directory"
  },
  "commands": [
    [
      "uv",
      "venv",
      "--seed",
      "--python",
      "<home>/.pyenv/versions/3.12.14/bin/python3",
      "<work>/tools"
    ],
    [
      "uv",
      "pip",
      "install",
      "--python",
      "<work>/tools/bin/python",
      "-e",
      ".",
      "Django==5.2.17",
      "Pillow==12.3.0",
      "build",
      "twine",
      "PyYAML",
      "-r",
      "requirements-lint.txt",
      "-r",
      "requirements-coverage.txt"
    ],
    [
      "npm",
      "install",
      "--package-lock-only",
      "--ignore-scripts"
    ],
    [
      "npm",
      "ci",
      "--ignore-scripts"
    ],
    [
      "npm",
      "test"
    ],
    [
      "npm",
      "run",
      "test:worker"
    ],
    [
      "env",
      "NOVA_PYTHON=<work>/tools/bin/python",
      "NOVA_DOM_REPORT=verification/2026-10-29-review-fixes/dom.json",
      "npm",
      "run",
      "test:dom"
    ],
    [
      "npx",
      "--yes",
      "--package=node@22.13.0",
      "node",
      "--test",
      "examples/worker-api/tests/backend.test.mjs"
    ],
    [
      "env",
      "-u",
      "PYTHONPATH",
      "DJANGO_SETTINGS_MODULE=tests.settings",
      "NOVA_TEST_DB=<work>/final-targeted.sqlite3",
      "<work>/tools/bin/python",
      "-m",
      "django",
      "test",
      "tests.test_rate_limit",
      "tests.test_policy",
      "tests.test_boundaries",
      "--noinput",
      "-v",
      "1"
    ],
    [
      "env",
      "-u",
      "PYTHONPATH",
      "DJANGO_SETTINGS_MODULE=tests.settings",
      "NOVA_TEST_DB=<work>/final-coverage.sqlite3",
      "COVERAGE_FILE=<work>/final-coverage/.coverage",
      "<work>/tools/bin/python",
      "-m",
      "coverage",
      "run",
      "-m",
      "django",
      "test",
      "tests",
      "--noinput",
      "-v",
      "1"
    ],
    [
      "env",
      "COVERAGE_FILE=<work>/final-coverage/.coverage",
      "<work>/tools/bin/python",
      "-m",
      "coverage",
      "combine",
      "--keep"
    ],
    [
      "env",
      "COVERAGE_FILE=<work>/final-coverage/.coverage",
      "<work>/tools/bin/python",
      "-m",
      "coverage",
      "json",
      "-o",
      "<work>/final-coverage/coverage.json"
    ],
    [
      "<work>/tools/bin/python",
      "scripts/check_coverage.py",
      "<work>/final-coverage/coverage.json"
    ],
    [
      "<work>/tools/bin/python",
      "scripts/test_coverage_gate.py",
      "<work>/final-coverage/coverage.json"
    ],
    [
      "<work>/tools/bin/ruff",
      "check",
      "."
    ],
    [
      "<work>/actionlint",
      "-version"
    ],
    [
      "<work>/actionlint"
    ],
    [
      "env",
      "-u",
      "PYTHONPATH",
      "DJANGO_SETTINGS_MODULE=tests.settings",
      "NOVA_TEST_DB=<work>/browser.sqlite3",
      "<work>/tools/bin/python",
      "-m",
      "django",
      "migrate",
      "--noinput"
    ],
    [
      "env",
      "-u",
      "PYTHONPATH",
      "DJANGO_SETTINGS_MODULE=tests.settings",
      "NOVA_TEST_DB=<work>/browser.sqlite3",
      "<work>/tools/bin/python",
      "-m",
      "django",
      "runserver",
      "127.0.0.1:8896",
      "--noreload"
    ],
    [
      "<work>/tools/bin/python",
      "verification/2026-10-29-review-fixes/browser_checks.py",
      "--work",
      "<work>"
    ],
    [
      "<work>/tools/bin/python",
      "verification/2026-10-29-review-fixes/configuration_probe.py",
      "--work",
      "<work>/configuration"
    ],
    [
      "<work>/tools/bin/python",
      "-m",
      "pip",
      "check"
    ],
    [
      "<work>/tools/bin/python",
      "-m",
      "build",
      "--outdir",
      "<work>/final-dist"
    ],
    [
      "<work>/tools/bin/python",
      "-m",
      "twine",
      "check",
      "--strict",
      "<work>/final-dist/nova_slider_captcha-0.3.0-py3-none-any.whl",
      "<work>/final-dist/nova_slider_captcha-0.3.0.tar.gz"
    ],
    [
      "<work>/tools/bin/python",
      "scripts/check_release.py",
      "--tag",
      "v0.3.0",
      "--dist",
      "<work>/final-dist"
    ],
    [
      "<work>/tools/bin/python",
      "scripts/test_matrix.py",
      "--runtimes",
      "<work>/runtimes",
      "--wheel",
      "<work>/final-dist/nova_slider_captcha-0.3.0-py3-none-any.whl",
      "--work",
      "<work>/final-matrix",
      "--workers",
      "3"
    ],
    [
      "git",
      "diff",
      "--check"
    ]
  ],
  "matrix_per_profile_commands": "See each matrix log for pip check, origin assertions, Django check, migration drift and complete tests."
}
